# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_analytics

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# API Keys and Auth (optional)
API_KEY=your-api-key-here
JWT_SECRET=change-this-in-production

# Admin endpoints (optional) - required to use /api/admin/migrate and
# /api/admin/seed-test-account (see README "Optional: Create a Test Account")
ADMIN_KEY=

# Google Sign-In (optional) - create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# Use the same value here and in packages/frontend/.env as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Stripe billing (optional) - from https://dashboard.stripe.com/apikeys and /webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pro: $12/mo billed monthly, or $10/mo ($120/yr) billed annually - create both Prices on
# the same Stripe Product and put their IDs here.
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
# Team is marked "Coming soon" in the UI and isn't purchasable yet - these are unused
# until it launches, but reserved so no code changes are needed when it does.
STRIPE_PRICE_ID_TEAM_MONTHLY=
STRIPE_PRICE_ID_TEAM_ANNUAL=

# Email verification (optional) - SMTP creds for sending verification emails.
# Without these, verification links are logged to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Test Analytics <no-reply@test-analytics.in>
